flowchart TD
    A[요구사항 확인<br/>사용자·업무 목적·데이터·규칙] --> B[핵심 규칙 정리<br/>ChatGPT 보조]
    B --> C[데이터 모델 설계<br/>테이블 후보·속성·관계·ERD·업무 규칙]
    C --> D[DDL과 SQL 초안<br/>Codex 보조]
    D --> E[SQL 실행·구조와 데이터 확인<br/>PostgreSQL·DBeaver]
    E --> F[요구사항과 실행 결과 비교<br/>사람 검토]
    F --> G{문제가 있는가?}

    G -- 예 --> H[문제 원인 확인]
    H --> I[관련 단계 수정<br/>요구사항 / 모델 / SQL / 실행]
    I --> J[수정한 단계부터 다시 실행]
    J --> F

    G -- 아니오 --> K[검증 완료]
    K --> L[GitHub에 변경 이력 기록]

    classDef step fill:#f8fafc,stroke:#64748b,stroke-width:2px;
    classDef execute fill:#eef5ff,stroke:#3b82f6,stroke-width:2px;
    classDef human fill:#f5f0ff,stroke:#7c4dcb,stroke-width:2px;
    classDef decision fill:#fff7e6,stroke:#d97706,stroke-width:2px;
    classDef complete fill:#eef9f1,stroke:#2f9a58,stroke-width:2px;

    class A,B,C,D step;
    class E execute;
    class F human;
    class G,H,I,J decision;
    class K,L complete;
