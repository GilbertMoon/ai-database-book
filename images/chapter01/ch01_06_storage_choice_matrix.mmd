flowchart TD
    A[① 기본 저장소 선택]
    A --> F[파일<br/>문서·설정값·단순 기록]
    A --> S[스프레드시트<br/>사람이 편집하는 소규모 표]
    A --> R[관계형 DB<br/>지속적 업무 데이터]

    F --> B[② 특수 기능이 필요한가?]
    S --> B
    R --> B

    B --> K[세션·캐시<br/>Key-Value DB 추가 검토]
    B --> V[의미 검색<br/>벡터 검색 계층 추가 검토]
    K --> C[③ 운영 중 재평가]
    V --> C

    classDef file fill:#eef9f1,stroke:#2f9a58,stroke-width:2px;
    classDef sheet fill:#eef5ff,stroke:#3b82f6,stroke-width:2px;
    classDef db fill:#f5f0ff,stroke:#7c4dcb,stroke-width:2px;
    classDef special fill:#fff7e6,stroke:#d97706,stroke-width:2px;
    classDef stage fill:#f8fafc,stroke:#64748b,stroke-width:2px;
    class A,B,C stage;
    class F file;
    class S sheet;
    class R db;
    class K,V special;
