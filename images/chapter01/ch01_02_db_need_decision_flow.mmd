flowchart TD
    A{동시 접근·관계·정확성·반복 검색·권한이 중요한가?}
    A -- 예 --> DB[관계형 데이터베이스 우선 검토<br/>PostgreSQL·MySQL]
    A -- 아니요 --> B{사람이 표로 직접 편집·계산하는가?}
    B -- 예 --> S[스프레드시트]
    B -- 아니요 --> F[파일]

    classDef q fill:#f8fafc,stroke:#64748b,stroke-width:2px;
    classDef db fill:#f5f0ff,stroke:#7c4dcb,stroke-width:2px;
    classDef sheet fill:#eef5ff,stroke:#3b82f6,stroke-width:2px;
    classDef file fill:#eef9f1,stroke:#2f9a58,stroke-width:2px;
    class A,B q;
    class DB db;
    class S sheet;
    class F file;
