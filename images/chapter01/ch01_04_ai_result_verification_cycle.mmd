flowchart LR
    A[요구사항과 검증 기준 정의] --> B[AI 초안 생성]
    B --> C[사람 검토]
    C --> D[격리된 테스트 환경 실행]
    D --> E[예상 결과와 실제 결과 비교]
    E --> F{검증 기준 통과?}
    F -- 아니요 --> G[수정 후 다시 검증]
    G --> A
    F -- 예 --> H[결과 채택·근거 기록]

    classDef step fill:#f8fafc,stroke:#64748b,stroke-width:2px;
    classDef ai fill:#e7fbf6,stroke:#1aa382,stroke-width:2px;
    classDef test fill:#eef5ff,stroke:#3b82f6,stroke-width:2px;
    classDef warn fill:#fff7e6,stroke:#d97706,stroke-width:2px;
    classDef done fill:#eef9f1,stroke:#2f9a58,stroke-width:2px;
    class A,C step;
    class B ai;
    class D,E test;
    class F,G warn;
    class H done;
