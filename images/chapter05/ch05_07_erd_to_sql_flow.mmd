flowchart TB
    A[검토된 ERD<br/>members 1 : N loans N : 1 books] --> B[ERD 요소를 SQL 요소로 대응]

    B --> B1[엔터티·테이블<br/>MEMBERS → members<br/>BOOKS → books<br/>LOANS → loans]
    B --> B2[속성·컬럼<br/>name·email·borrowed_at 등]
    B --> B3[PK·행 식별<br/>id → SERIAL PRIMARY KEY]
    B --> B4[관계·FK<br/>N쪽 loans에 member_id·book_id]
    B --> B5[필수·고유·선택 규칙<br/>NOT NULL·UNIQUE·NULL 허용]

    B1 --> C[PostgreSQL 물리 설계]
    B2 --> C
    B3 --> C
    B4 --> C
    B5 --> C

    C --> C1[컬럼별 데이터 타입과 길이 결정<br/>VARCHAR·INT·DATE]
    C --> C2[FK 문법 결정<br/>REFERENCES members(id)<br/>REFERENCES books(id)]
    C --> C3[생성 순서 결정<br/>참조되는 부모 members·books 먼저<br/>참조하는 자식 loans 나중]
    C --> C4[재실행·삭제 순서 결정<br/>DROP은 자식 loans부터 부모 방향]

    C1 --> M[CREATE TABLE members<br/>id SERIAL PRIMARY KEY<br/>email VARCHAR(100) UNIQUE NOT NULL]
    C1 --> K[CREATE TABLE books<br/>id SERIAL PRIMARY KEY<br/>published_year INT NULL 허용<br/>isbn VARCHAR(20) UNIQUE NOT NULL]
    C2 --> L[CREATE TABLE loans<br/>member_id INT NOT NULL REFERENCES members(id)<br/>book_id INT NOT NULL REFERENCES books(id)]
    C3 --> M
    C3 --> K
    M --> L
    K --> L

    L --> D[전체 SQL을 한 문장씩 검토<br/>테이블·컬럼·타입·쉼표·괄호·참조 이름 확인]
    C4 --> D
    D --> E[DBeaver에서 부모 → 자식 순서로 실행]

    E --> F{테이블 생성에<br/>성공했는가?}
    F -- 아니요 --> F1[전체 오류 메시지 확인<br/>문법·생성 순서·기존 객체·참조 이름 수정]
    F1 --> C
    F -- 예 --> G[DB 메타데이터 확인<br/>컬럼 타입·PK·UK·FK·NULL 허용이 ERD와 같은지 검토]

    G --> H[샘플 데이터 입력<br/>members·books 먼저, loans 나중]
    H --> H1[정상 사례<br/>회원·책·대여 기록 저장]
    H --> H2[선택값 사례<br/>published_year 또는 returned_at이 NULL]
    H --> H3[오류 사례<br/>중복 email·isbn, 존재하지 않는 member_id·book_id]

    H1 --> I[JOIN으로 관계와 업무 질문 검증]
    H2 --> I
    H3 --> I
    I --> I1[loans.member_id = members.id]
    I --> I2[loans.book_id = books.id]
    I1 --> J{요구사항·ERD·SQL·실행 결과가<br/>서로 일치하는가?}
    I2 --> J

    J -- 아니요 --> J1[원인 위치 구분<br/>요구사항 누락·ERD 오류·SQL 변환 오류·테스트 오류]
    J1 --> A
    J -- 예 --> K1[설계 기준선 기록<br/>ERD 버전·CREATE TABLE SQL·샘플 데이터·검증 질의 연결]

    N1[변환 원칙<br/>ERD를 기계적으로 복사하는 것이 아니라<br/>각 관계와 제약조건을 PostgreSQL 문법으로 명시] --- B
    N2[생성 순서<br/>FK가 참조할 부모 테이블이 먼저 존재해야 하므로<br/>members·books 다음에 loans를 생성] --- C3
    N3[실행 성공만으로 부족<br/>테이블이 생성돼도 NOT NULL·UNIQUE·FK가 빠지면<br/>요구사항을 지키지 못하는 구조] --- G
    N4[수정 방향<br/>검증 실패 시 SQL만 임시 수정하지 말고<br/>요구사항과 ERD에도 같은 변경을 반영] --- J1
    N5[핵심<br/>ERD 요소 대응 → 타입·제약조건 결정 → 순서대로 생성 → 데이터와 JOIN으로 검증] --- J
