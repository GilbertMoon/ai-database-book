flowchart LR
    subgraph BAD[역할이 섞인 설계]
        direction TB
        BAD_TABLE["ai_review_lab.bad_enrollments<br/>student_email TEXT<br/>course_price TEXT<br/>payment_status TEXT<br/>enrollment_status TEXT<br/>sensitive_value_plaintext TEXT<br/>created_at TEXT"]
        BAD_RISK["반복 데이터<br/>타입·상태값 검증 부족<br/>FK 없음<br/>민감정보 평문 저장 위험"]
