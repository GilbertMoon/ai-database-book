flowchart TD
    A[ai_database_book 데이터베이스 연결] --> B[SQL Editor 열기]
    B --> C[SELECT version();]
    C --> C1[PostgreSQL 버전 확인]
    C1 --> D[SELECT current_database();]
    D --> D1[현재 DB가 ai_database_book인지 확인]
    D1 --> E[SELECT 1 + 1 AS result;]
    E --> E1[결과 2 확인]
    E1 --> F[students 테이블 생성]
    F --> G[샘플 데이터 INSERT]
    G --> H[SELECT * FROM students;]
    H --> I[조회 결과 확인]
    I --> J[UNIQUE 오류 실습]
    J --> K[제약조건 동작 확인]
