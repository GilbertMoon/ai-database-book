flowchart TB
    A[code/chapter03/setup_check.sql 열기] --> B[실행할 DBeaver 연결 확인<br/>current_database 결과가 ai_database_book이어야 함]
    B --> C{현재 실습 상태는?}

    C -- 처음 실행·빈 환경 --> F[전체 기본 구간 실행 준비]
    C -- students가 이미 존재 --> R{재실행 목적 선택}
    R -- 기존 결과 유지·일부만 확인 --> R1[필요한 SELECT 또는 오류 실습 문장만 선택 실행]
    R -- 처음부터 다시 실습 --> R2[연습용 DB인지 확인 후<br/>주석 처리된 DROP TABLE IF EXISTS를 의도적으로 실행]
    R2 --> F

    subgraph BASIC[1. 연결과 SQL 실행 환경 확인]
        F --> V[SELECT version();<br/>PostgreSQL 서버 응답 확인]
        V --> D[SELECT current_database();<br/>작업 DB가 ai_database_book인지 확인]
        D --> Q[SELECT 1 + 1 AS result;<br/>결과 그리드에 2가 표시되는지 확인]
    end

    Q --> G{세 결과가 예상과<br/>일치하는가?}
    G -- 아니요 --> X1[연결·현재 DB·실행 범위·오류 패널 점검]
    X1 --> B
    G -- 예 --> T[구조·데이터 실습 진행]

    subgraph DATA[2. 테이블 생성과 데이터 확인]
        T --> T1[CREATE TABLE students<br/>PK·NOT NULL·UNIQUE·DEFAULT 정의]
        T1 --> T2[INSERT 샘플 학생 3건]
        T2 --> T3[SELECT * FROM students]
        T3 --> T4[검증<br/>행 3개·서로 다른 id·created_at 자동값·입력한 이름과 이메일]
    end

    T4 --> U{구조와 데이터가<br/>예상과 일치하는가?}
    U -- 아니요 --> X2[Error 패널·영향받은 행 수·테이블 구조·기존 데이터 확인]
    X2 --> R
    U -- 예 --> E[선택 실습<br/>주석 처리된 중복 이메일 INSERT 한 문장만 실행]

    E --> J{UNIQUE 위반 오류가<br/>예상대로 발생하는가?}
    J -- 예 --> K[제약조건 정상 동작 확인<br/>잘못된 행은 저장되지 않음]
    J -- 아니요 --> L[email 열의 UNIQUE 정의와<br/>기존 이메일 데이터·실행 문장 확인]
    L --> E

    K --> Z[실습 결과 기록<br/>서버 버전·현재 DB·행 수·예상 오류·수정 사항]

    N1[기본 파일 설계<br/>DROP TABLE과 중복 이메일 INSERT는 기본 실행에서 주석 처리되어<br/>초기화와 의도적 오류를 사용자가 선택하도록 구성] --- A
    N2[재실행 주의<br/>같은 파일을 그대로 다시 실행하면 table already exists 또는<br/>중복 데이터 오류가 발생할 수 있으므로 현재 상태를 먼저 확인] --- R
    N3[삭제 안전<br/>DROP TABLE은 데이터를 제거하므로 개인 연습용 DB와 대상 테이블을 확인한 뒤 실행] --- R2
    N4[오류 해석<br/>예상한 UNIQUE 오류는 환경 실패가 아니라 데이터 규칙이 작동한다는 검증 결과] --- J
    N5[핵심<br/>파일 실행은 성공 여부만 보는 것이 아니라 각 구간의 예상 결과와 현재 DB 상태를 비교하는 과정] --- T4
